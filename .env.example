# Server
NODE_ENV=development
PORT=5000

# Comma-separated browser origins allowed to call this API (credentials enabled).
# Add your Vercel production URL here when deploying the LC portal.
CORS_ORIGIN=http://localhost:5174,http://localhost:5173,http://localhost:3000,https://prepsmart-language-cert-frontend.vercel.app

# Allow any https://*.vercel.app origin (production + preview deploys). Set to false to disable.
CORS_ALLOW_VERCEL=true

# Allow any https://*.up.railway.app origin. Set to false to disable.
CORS_ALLOW_RAILWAY=true

# In production, also allow http://localhost:* (useful for local dev against Railway). Default: false.
# CORS_ALLOW_LOCALHOST=true

# Supabase (get these from https://supabase.com/dashboard/project/sepzceaicoldqhyxxzff/settings/api)
SUPABASE_URL=https://sepzceaicoldqhyxxzff.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# LC admin login (set via: node scripts/ensure-admin-user.mjs)
# Email: contact@scoresmartpte.com
# Password: SCORE2026

# JWT (same as Supabase JWT Secret — Settings > API > JWT Settings)
JWT_SECRET=your_supabase_jwt_secret_here
JWT_EXPIRES_IN=7d

# Claude (writing + speaking scoring via AI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure Speech Services (speaking audio transcription)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=australiaeast

# ---------------------------------------------------------------------------
# Live speaking examiner (realtime WebSocket)
# ---------------------------------------------------------------------------
# The examiner runs on this same service at wss://<host>/realtime/speaking.
# There is no second port and no second Railway service to deploy.
#
# Required to enable it. Server-side only — never expose this to the browser
# and never give it a VITE_ prefix, or Vite would inline it into the bundle.
# Without it the API still boots; only the live examiner is switched off.
OPENAI_API_KEY=sk-proj-your_openai_key_here

# ---------------------------------------------------------------------------
# Speaking set agent (POST /api/v1/questions/speaking/sets/generate, admin only,
# or: npm run generate:speaking-sets -- --count 5 --level B1 --publish)
# ---------------------------------------------------------------------------
# Claude writes the questions (ANTHROPIC_API_KEY); OpenAI draws the Part 3
# picture (OPENAI_API_KEY). Both are optional overrides:
# SPEAKING_AGENT_MODEL=claude-opus-5
# OPENAI_IMAGE_MODEL=gpt-image-1

# The frontend must point at this service:
#   VITE_REALTIME_EXAM_WS_URL=wss://<your-service>.up.railway.app/realtime/speaking
# Origins are allowed using the same CORS_* settings as the REST API above.
# Set this only to override that list for the WebSocket alone:
# REALTIME_ALLOWED_ORIGINS=https://prepsmart-language-cert-frontend.vercel.app

# The exam socket requires a valid Supabase session (?token=...) by default,
# verified the same way the REST API verifies a Bearer token. The frontend
# attaches the token itself. Only set this if you need to disable that check:
# REALTIME_REQUIRE_AUTH=false

# Optional tuning; every one has a sane default in src/realtime/examinerSession.mjs.
# REALTIME_MODEL=gpt-realtime
# REALTIME_VOICE=cedar                # marin, cedar, alloy, ...
# REALTIME_NUDGE_MS=8000              # silence before "are you there?"
# REALTIME_MAX_NUDGES=3               # checks before the test is abandoned
# REALTIME_MAX_EXAM_MS=1200000        # 20-minute ceiling
# REALTIME_MAX_CONCURRENT=4           # concurrent exams on this instance
# REALTIME_VAD_THRESHOLD=0.5          # mic sensitivity — raise in a noisy room
# REALTIME_DEBUG=1                    # log every script decision

# Transcript auto-save. Railway's filesystem is ephemeral, so these are a
# debugging aid only — the scored attempt is saved through the practice API.
# Point at a mounted volume to keep them, or set to off to skip disk writes.
# REALTIME_SESSION_DIR=.realtime-sessions
